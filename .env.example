# Disaster Management System - Environment Variables
# Copy this file to .env and update the values

# Security - CHANGE THIS IN PRODUCTION!
SECRET_KEY=change-this-to-a-secure-random-string-at-least-32-chars

# Database (SQLite for simplicity, switch to PostgreSQL for production)
DATABASE_URL=sqlite+aiosqlite:///./data/disaster_management.db

# CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost
